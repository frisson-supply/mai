PUBLIC_SANITY_PROJECT_ID=<from sanity.io/manage>
PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=<Viewer token from sanity.io/manage> # also used for draft/preview reads and to validate /api/preview secrets
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:4321 # site origin the Studio's Presentation tool previews (prod: your deployed URL)
SITE_GATE_PASSWORD= # set to enable the "coming soon" gate on the whole site (except /studio and /api/*); leave blank to disable
