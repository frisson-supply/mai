---
import styles from "./work-toggle.module.css";
---

<div class={styles["work-toggle"]}>
    <button
        class={styles["work-toggle__btn"]}
        data-view-btn="grid"
        data-split="paragraph">Grid</button
    >
    <span class={styles["work-toggle__sep"]} data-split="paragraph" aria-hidden="true">/</span>
    <button
        class={styles["work-toggle__btn"]}
        data-view-btn="list"
        data-split="paragraph">List</button
    >
</div>
