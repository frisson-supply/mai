---
import { urlFor } from "@/lib/sanity";
import styles from "./work-list.module.css";
import type { HomeListItem } from "@/lib/types";

interface Props {
    items: HomeListItem[];
}

const { items } = Astro.props;

type ItemWithProject = HomeListItem & { project: NonNullable<HomeListItem['project']> };
function hasProject(item: HomeListItem): item is ItemWithProject {
    return Boolean(item.project);
}
---

<div class={styles["work-layout"]} id="work-layout">
    <div class={styles["work"]} id="work-section">
        {
            items.map(
                (item, i) =>
                    item.project && (
                        <a
                            href={`/works/${item.project.slug}`}
                            class={styles["work-item"]}
                            data-item-index={i}
                            data-project-slug={item.project.slug}
                            data-work-item
                        >
                            <div
                                class={styles["work-item__thumb"]}
                                data-work-thumb
                            >
                                {item.project.thumbnail ? (
                                    <img
                                        src={urlFor(item.project.thumbnail)
                                            .width(800)
                                            .url()}
                                        alt={
                                            item.project.thumbnail.alt ||
                                            item.project.title
                                        }
                                        loading="lazy"
                                    />
                                ) : (
                                    <div />
                                )}
                            </div>
                            <div class={styles["work-item__info"]}>
                                <span
                                    class={styles["work-item__title"]}
                                    data-work-line
                                >
                                    {item.project.title}
                                </span>
                                <span
                                    class={styles["work-item__meta"]}
                                    data-work-line
                                >
                                    {item.project.tags?.join(" · ")}
                                </span>
                            </div>
                        </a>
                    ),
            )
        }
    </div>
    <nav class={styles["work-list-names"]} id="work-list-names">
        {
            items
                .filter(hasProject)
                .map((item, i) => (
                    <a
                        href={`/works/${item.project.slug}`}
                        class={styles["work-list-name"]}
                        data-name-index={i}
                        data-project-slug={item.project.slug}
                        data-work-list-name
                    >
                        <span class={styles["work-list-name__label"]}>
                            <span
                                class={styles["work-list-name__text"]}
                                data-work-list-text
                            >
                                {item.project.title}
                            </span>
                        </span>
                    </a>
                ))
        }
    </nav>
</div>
