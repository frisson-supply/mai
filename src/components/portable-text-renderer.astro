---
import { urlFor } from '../lib/sanity';

interface TextSpan {
  _type: string;
  text: string;
  marks?: string[];
}

interface Block {
  _type: string;
  _key: string;
  style?: string;
  children?: TextSpan[];
  // imageBlock fields
  image?: { asset: any; alt?: string };
  size?: string;
  position?: string;
  caption?: string;
  // textImageBlock fields
  text?: Block[];
  imagePosition?: 'left' | 'right';
  imageSize?: 'one-third' | 'half' | 'two-thirds';
}

interface Props {
  blocks: Block[];
}

const { blocks = [] } = Astro.props;

function renderText(children: Block['children']) {
  if (!children) return '';
  return children.map(span => span.text || '').join('');
}

const imageSizeMap: Record<string, string> = {
  'one-third':  '33.33%',
  'half':       '50%',
  'two-thirds': '66.66%',
};
---

<div class="portable-text">
  {blocks.map((block) => {
    if (block._type === 'block') {
      const text = renderText(block.children);
      if (block.style === 'h2') return <h2 data-split="title">{text}</h2>;
      if (block.style === 'h3') return <h3 data-split="title">{text}</h3>;
      return <p data-split="paragraph">{text}</p>;
    }

    if (block._type === 'imageBlock' && block.image) {
      const size     = block.size ?? 'full';
      const position = size === 'full' ? '' : ` image-block--${block.position ?? 'center'}`;
      return (
        <figure class={`image-block image-block--${size}${position}`}>
          <img
            src={urlFor(block.image).width(1200).url()}
            alt={block.image.alt || ''}
          />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );
    }

    if (block._type === 'textImageBlock' && block.image) {
      const position  = block.imagePosition ?? 'right';
      const size      = block.imageSize ?? 'half';
      const imgWidth  = imageSizeMap[size] ?? '50%';
      return (
        <div
          class={`text-image-block text-image-block--image-${position}`}
          style={`--image-width: ${imgWidth}`}
        >
          <div class="text-image-block__text">
            {(block.text ?? []).map((inner) => {
              const t = renderText(inner.children);
              if (inner.style === 'h2') return <h2 data-split="title">{t}</h2>;
              if (inner.style === 'h3') return <h3 data-split="title">{t}</h3>;
              return <p data-split="paragraph">{t}</p>;
            })}
          </div>
          <div class="text-image-block__image">
            <img
              src={urlFor(block.image).width(800).url()}
              alt={block.image.alt || ''}
            />
          </div>
        </div>
      );
    }

    return null;
  })}
</div>
