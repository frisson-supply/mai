---
const icons = import.meta.glob<string>('../../assets/icons/*.svg', {
    query: '?raw',
    import: 'default',
    eager: true,
});

interface Props {
    name: string;
    class?: string;
}

const { name, class: className } = Astro.props;
let svg = icons[`../../assets/icons/${name}.svg`];

// Make gradient/clip-path IDs unique so multiple instances on the same page
// don't conflict with each other.
if (svg) {
    const uid = `${name}-${Math.random().toString(36).slice(2, 7)}`;
    svg = svg.replace(
        /\bid="([^"]+)"|url\(#([^)]+)\)|href="#([^"]+)"/g,
        (match, idVal, urlVal, hrefVal) => {
            if (idVal !== undefined) return `id="${uid}-${idVal}"`;
            if (urlVal !== undefined) return `url(#${uid}-${urlVal})`;
            return `href="#${uid}-${hrefVal}"`;
        }
    );
}
---

{svg && <Fragment set:html={svg} class:list={[className]} />}
