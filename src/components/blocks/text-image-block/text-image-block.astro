---
import { urlFor } from '@/lib/sanity';
import { cn } from '@/utils/cn';
import styles from './text-image-block.module.css';

interface TextSpan { _type: string; text: string; marks?: string[]; }
interface Block { _type: string; _key: string; style?: string; children?: TextSpan[]; }

interface Props {
  text: Block[];
  image: { asset: any; alt?: string };
  imagePosition?: 'left' | 'right';
  imageSize?: 'one-third' | 'half' | 'two-thirds';
}

const sizeMap: Record<string, string> = { 'one-third': '33.33%', 'half': '50%', 'two-thirds': '66.66%' };

const { text = [], image, imagePosition = 'right', imageSize = 'half' } = Astro.props;
const imgWidth = sizeMap[imageSize] ?? '50%';
---

<div
  class={cn(styles['text-image-block'], styles[`text-image-block-image-${imagePosition}`])}
  style={`--image-width: ${imgWidth}`}
>
  <div class={styles['text-image-block-text']}>
    {text.map(block => {
      const t = (block.children ?? []).map(s => s.text || '').join('');
      if (block.style === 'h2') return <h2 data-split="title">{t}</h2>;
      if (block.style === 'h3') return <h3 data-split="title">{t}</h3>;
      return <p data-split="paragraph">{t}</p>;
    })}
  </div>
  <div class={styles['text-image-block-image']} data-reveal>
    <img src={urlFor(image).width(800).url()} alt={image.alt || ''} />
  </div>
</div>
