---
import styles from './video-section.module.css';

interface Props {
  url: string;
  aspectRatio?: string;
  caption?: string;
}

const { url, aspectRatio = '16/9', caption } = Astro.props;
---

<figure class={styles['video-section']} data-reveal>
  <div class={styles['video-section__embed']} style={`aspect-ratio: ${aspectRatio}`}>
    <iframe src={url} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
