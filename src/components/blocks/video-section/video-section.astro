---
import styles from './video-section.module.css';

interface Props {
  url: string;
  aspectRatio?: string;
  caption?: string;
  reveal?: boolean;
}

const { url, aspectRatio = '16/9', caption, reveal = true } = Astro.props;
---

<figure class={styles['video-section']} {...(reveal ? { 'data-reveal': true } : {})}>
  <div class={styles['video-section-player']} style={`aspect-ratio: ${aspectRatio}`}>
    <iframe
      class={styles['video-section-iframe']}
      src={url}
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
