---
import { urlFor } from '@/lib/sanity';
import { cn } from '@/utils/cn';
import styles from './image-block.module.css';

interface Props {
  image: { asset: any; alt?: string };
  size?: string;
  position?: string;
  caption?: string;
}

const { image, size = 'full', position, caption } = Astro.props;
const pos = size !== 'full' ? (position ?? 'center') : null;
---

<figure class={cn(styles['image-block'], styles[`image-block--${size}`], pos && styles[`image-block--${pos}`])} data-reveal>
  <img src={urlFor(image).width(1200).url()} alt={image.alt || ''} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
