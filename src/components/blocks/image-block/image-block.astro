---
import { urlFor } from '@/lib/sanity';
import { cn } from '@/utils/cn';
import styles from './image-block.module.css';

interface Props {
  image: { asset: any; alt?: string };
  width?: 'narrow' | 'normal' | 'wide' | 'full';
  position?: 'left' | 'off-left-centre' | 'centre' | 'off-right-centre' | 'right';
  caption?: string;
}

const { image, width = 'full', position, caption } = Astro.props;
const pos = width !== 'full' ? (position ?? 'left') : null;
---

<figure class={cn(styles['image-block'], styles[`image-block--${width}`], pos && styles[`image-block--${pos}`])} data-reveal>
  <img src={urlFor(image).width(1200).url()} alt={image.alt || ''} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
