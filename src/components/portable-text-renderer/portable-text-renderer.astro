---
import ImageBlock from '@/components/blocks/image-block/image-block.astro';
import TextImageBlock from '@/components/blocks/text-image-block/text-image-block.astro';
import type { PortableTextItem, PortableTextBlock } from '@/lib/types';

interface Props {
  blocks: PortableTextItem[];
}

const { blocks = [] } = Astro.props;

function renderText(children: PortableTextBlock['children']) {
  return (children ?? []).map(s => s.text || '').join('');
}
---

<div class="portable-text">
  {blocks.map((block) => {
    if (block._type === 'block') {
      const text = renderText(block.children);
      if (block.style === 'h2') return <h2 data-split="title">{text}</h2>;
      if (block.style === 'h3') return <h3 data-split="title">{text}</h3>;
      return <p data-split="paragraph">{text}</p>;
    }

    if (block._type === 'imageBlock' && block.image)
      return <ImageBlock image={block.image} width={block.width} position={block.position} caption={block.caption} />;

    if (block._type === 'textImageBlock' && block.image)
      return <TextImageBlock text={block.text ?? []} image={block.image} imagePosition={block.imagePosition} imageSize={block.imageSize} />;

    return null;
  })}
</div>
