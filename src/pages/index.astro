---
export const prerender = true;

import Layout from '@/layouts/layout.astro';
import { getSiteSettings, getAllProjects } from '@/lib/queries';
import { urlFor } from '@/lib/sanity';
import styles from './index.module.css';

const settings = await getSiteSettings();
const projects = await getAllProjects();
---

<Layout title={settings?.siteTitle || 'Mai'} namespace="home" pageTheme="light">
  <div class={styles['work-toggle']}>
    <button class={styles['work-toggle__btn']} data-view-btn="grid" data-split="paragraph">Grid</button>
    <span class={styles['work-toggle__sep']} data-split="paragraph">/</span>
    <button class={styles['work-toggle__btn']} data-view-btn="list" data-split="paragraph">List</button>
  </div>
  <div class={styles['cases-label']}>Cases</div>
  <div class={styles['work-layout']} id="work-layout">
    <div class={styles['work']} id="work-section" data-view="grid">
      {projects.map((project: any, i: number) => (
        <a href={`/works/${project.slug}`} class={styles['work-item']} data-item-index={i} data-work-item>
          <div class={styles['work-item__thumb']}>
            {project.thumbnail
              ? <img src={urlFor(project.thumbnail).width(800).url()} alt={project.thumbnail.alt || project.title} loading="lazy" />
              : <div />
            }
          </div>
          <div class={styles['work-item__info']}>
            <span class={styles['work-item__index']}>{String(i + 1).padStart(2, '0')}</span>
            <span class={styles['work-item__title']}>{project.title}</span>
            <span class={styles['work-item__meta']}>{[project.client, project.year].filter(Boolean).join(' · ')}</span>
          </div>
        </a>
      ))}
    </div>
    <nav class={styles['work-list-names']} id="work-list-names">
      {projects.map((project: any, i: number) => (
        <a href={`/works/${project.slug}`} class={styles['work-list-name']} data-name-index={i} data-work-list-name>
          <span>{project.title}</span>
        </a>
      ))}
    </nav>
  </div>
</Layout>
