---
export const prerender = true;

import Layout from "@/layouts/layout.astro";
import WorkToggle from "@/components/work-toggle/work-toggle.astro";
import WorkGrid from "@/components/work-grid/work-grid.astro";
import { getSiteSettings, getHomeGrid } from "@/lib/queries";
import styles from "./index.module.css";

const settings = await getSiteSettings();
const homeGrid = await getHomeGrid();
const gridItems = homeGrid?.items ?? [];
---

<Layout title={settings?.siteTitle || "Mai"} namespace="home" pageTheme="light">
    <WorkToggle />
    <div class={styles["cases-label"]} data-split="title">Cases</div>
    <WorkGrid items={gridItems} />
</Layout>
