---
import Layout from "@/layouts/layout.astro";
import WorkCarousel from "@/components/work-carousel/work-carousel.astro";
import { getSiteSettings, getHomeList } from "@/lib/queries";
import styles from "./index.module.css";

const settings = await getSiteSettings();
const homeList = await getHomeList();
const listItems = homeList?.items ?? [];
---

<Layout title={settings?.siteTitle || "Mai"} namespace="home" pageTheme="light">
    <h2 class={styles["cases-label"]} data-split="title">Cases</h2>
    <WorkCarousel items={listItems} />
</Layout>
