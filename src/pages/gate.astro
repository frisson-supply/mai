---
import '@/global.css';

export const prerender = false;

const password = import.meta.env.SITE_GATE_PASSWORD;
const next = Astro.url.searchParams.get('next') || '/';
let error = false;

if (!password) {
  return Astro.redirect('/');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submitted = form.get('password');

  if (typeof submitted === 'string' && submitted === password) {
    Astro.cookies.set('site-gate', 'unlocked', {
      path: '/',
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 30,
    });
    return Astro.redirect(next);
  }

  error = true;
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Coming soon</title>
  </head>
  <body>
    <main style="min-height:100dvh; display:grid; place-items:center; background:var(--color-bg); color:var(--color-fg);">
      <form method="POST" style="display:flex; flex-direction:column; gap:1rem; width:min(90vw, 320px);">
        <h1 style="font-size:1.25rem; margin:0;">Coming soon</h1>
        <input
          type="password"
          name="password"
          placeholder="Password"
          autofocus
          required
          style="padding:0.75rem; background:transparent; border:1px solid var(--border); color:var(--color-fg); border-radius:4px;"
        />
        {error && <p style="color:var(--color-accent); margin:0;">Incorrect password.</p>}
        <button
          type="submit"
          style="padding:0.75rem; background:var(--color-accent); color:var(--color-bg); border:none; border-radius:4px; cursor:pointer;"
        >
          Enter
        </button>
      </form>
    </main>
  </body>
</html>
