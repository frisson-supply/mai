---
export const prerender = true;

import Layout from '../layouts/layout.astro';
import { getSiteSettings } from '../lib/queries';

const settings = await getSiteSettings();
---

<Layout title="Contact — Mai" namespace="contact" pageTheme="dark">
  <section class="hero">
    <h1>Contact</h1>
    <p>Let's work together.</p>
    {settings?.socialLinks && settings.socialLinks.length > 0 && (
      <div style="display:flex;gap:1.5rem;margin-top:2rem;flex-wrap:wrap;justify-content:center;">
        {settings.socialLinks.map((link: any) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            style="color:#fff;text-decoration:none;font-size:0.875rem;text-transform:uppercase;letter-spacing:0.1em;border-bottom:1px solid #555;padding-bottom:2px;"
          >
            {link.platform}
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
