---
export const prerender = true;

import Layout from '../layouts/layout.astro';
import PortableTextRenderer from '../components/portable-text-renderer.astro';
import { getAbout } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const about = await getAbout();
---

<Layout title="About — Mai" namespace="about" pageTheme="dark">
  <section class="hero">
    <article class="project-detail" style="padding-top:6rem">
      {about?.photo && (
        <img
          src={urlFor(about.photo).width(400).url()}
          alt={about.photo.alt || 'Profile photo'}
          style="width:200px;height:200px;object-fit:cover;border-radius:50%;margin-bottom:2rem;"
        />
      )}
      <h1 style="font-size:clamp(2rem,5vw,4rem);margin-bottom:2rem;">About</h1>
      {about?.bio && <PortableTextRenderer blocks={about.bio} />}
      {about?.skills && about.skills.length > 0 && (
        <div style="margin-top:2rem;">
          <h2 style="font-size:1.25rem;margin-bottom:1rem;">Skills</h2>
          <div class="project-detail__tags">
            {about.skills.map((skill: string) => (
              <span class="project-detail__tag">{skill}</span>
            ))}
          </div>
        </div>
      )}
      {about?.cvUrl && (
        <a href={about.cvUrl} target="_blank" rel="noopener noreferrer" style="display:inline-block;margin-top:2rem;color:#fff;text-decoration:underline;">
          Download CV
        </a>
      )}
    </article>
  </section>
</Layout>
