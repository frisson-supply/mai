---
import Layout from '@/layouts/layout.astro';
import SectionsRenderer from '@/components/sections-renderer/sections-renderer.astro';
import NextProject from '@/components/next-project/next-project.astro';
import VideoSection from '@/components/blocks/video-section/video-section.astro';
import { getProjectBySlug, getNextProject } from '@/lib/queries';
import { getClient, isPreviewMode } from '@/lib/preview';
import { urlFor } from '@/lib/sanity';
import styles from './slug.module.css';

export const prerender = false;

const { slug } = Astro.params;
const preview = isPreviewMode(Astro.cookies);
const client = getClient(Astro.cookies);
const [project, nextProject] = await Promise.all([
  getProjectBySlug(slug!, client),
  getNextProject(slug!, client),
]);

if (!project) {
  return Astro.redirect('/');
}

if (preview) {
  Astro.response.headers.set('Cache-Control', 'no-store');
}
---

<Layout
  title={project.metaTitle || `${project.title} — Mai`}
  description={project.metaDescription || project.description}
  ogImage={project.metaImageUrl}
  namespace="project"
  pageTheme="light"
>
  <article class={styles['project-detail']}>

    <header class={styles['project-detail-header']}>
      <h1 data-split="title">{project.title}</h1>
      {project.description && (
        <p class={styles['project-detail-description']} data-split="paragraph">{project.description}</p>
      )}
    </header>

    {project.videoUrl && (
      <div class={styles['project-detail-video']} data-video-hero>
        <VideoSection url={project.videoUrl} reveal={false} />
      </div>
    )}

    {project.thumbnail && !project.videoUrl && (
      <img
        src={urlFor(project.thumbnail).width(1200).url()}
        alt={project.thumbnail.alt || project.title}
        class={styles['project-detail-hero-img']}
        data-reveal
      />
    )}

    <div class={styles['project-detail-info']}>
      <dl class={styles['project-detail-info-meta']}>
        {project.released && (
          <div class={styles['project-detail-info-item']}>
            <dt data-split="paragraph">Released</dt>
            <dd data-split="paragraph">{project.released}</dd>
          </div>
        )}
        {project.duration && (
          <div class={styles['project-detail-info-item']}>
            <dt data-split="paragraph">Duration</dt>
            <dd data-split="paragraph">{project.duration}</dd>
          </div>
        )}
        {project.genre && (
          <div class={styles['project-detail-info-item']}>
            <dt data-split="paragraph">Genre</dt>
            <dd data-split="paragraph">{project.genre}</dd>
          </div>
        )}
        {project.role && (
          <div class={styles['project-detail-info-item']}>
            <dt data-split="paragraph">Role</dt>
            <dd data-split="paragraph">{project.role}</dd>
          </div>
        )}
      </dl>
      {project.infoImage && (
        <div class={styles['project-detail-info-image']} data-reveal>
          <img
            src={urlFor(project.infoImage).width(1200).url()}
            alt={project.infoImage.alt || project.title}
          />
        </div>
      )}
    </div>

    {project.sections && project.sections.length > 0 && (
      <div class={styles['project-detail-sections']}>
        <SectionsRenderer sections={project.sections} />
      </div>
    )}

  </article>

  {nextProject && <NextProject project={nextProject} />}
</Layout>
