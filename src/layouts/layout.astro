---
import "@/global.css";
import styles from "./layout.module.css";
import { getSiteSettings } from "@/lib/queries";
import Icon from "@/components/icon/icon.astro";
import Analytics from "@vercel/analytics/astro";
import VisualEditing from "@/components/visual-editing/visual-editing";
import { isPreviewMode } from "@/lib/preview";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    namespace?: string;
    pageTheme?: "light" | "dark";
}

const {
    title = "Mai",
    description,
    ogImage,
    namespace,
    pageTheme = "dark",
} = Astro.props;
const preview = isPreviewMode(Astro.cookies);
const path = Astro.url.pathname;
const settings = await getSiteSettings();

const siteName = settings?.siteTitle ?? "Mai";
const siteNameParts = siteName.split(" ");
const siteFirstName = siteNameParts[0];
const siteLastName = siteNameParts.slice(1).join(" ") || "";
const siteRole = settings?.role ?? "";

function isActive(href: string) {
    if (href === "/") return path === "/";
    return path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        {
            settings?.faviconUrl ? (
                <link rel="icon" href={settings.faviconUrl} />
            ) : (
                <link rel="icon" href="/favicon.svg" />
            )
        }
        {description && <meta name="description" content={description} />}
        <meta property="og:title" content={title} />
        {
            description && (
                <meta property="og:description" content={description} />
            )
        }
        {(ogImage ?? settings?.ogImageUrl) && <meta property="og:image" content={ogImage ?? settings?.ogImageUrl} />}
        <meta property="og:type" content="website" />
        <meta
            name="twitter:card"
            content={(ogImage ?? settings?.ogImageUrl) ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={title} />
        {
            description && (
                <meta name="twitter:description" content={description} />
            )
        }
        {(ogImage ?? settings?.ogImageUrl) && <meta name="twitter:image" content={ogImage ?? settings?.ogImageUrl} />}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&display=swap" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/CustomEase.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/SplitText.min.js" />
        <script is:inline>
            if (
                typeof sessionStorage !== "undefined" &&
                sessionStorage.getItem("mai_loaded")
            ) {
                document.documentElement.classList.add("loader-done");
            }
        </script>
        <Analytics />
    </head>
    <body data-page-theme={pageTheme} data-namespace={namespace} data-preview={preview}>
        {
            path === "/" && (
                <div id="page-loader" class={styles["page-loader"]}>
                    <div class={styles["page-loader-bg"]} data-loader="bg">
                        <div
                            class={styles["page-loader-bar"]}
                            data-loader="bar"
                        />
                    </div>
                    <div
                        class={styles["page-loader-content"]}
                        data-loader="content"
                    >
                        {siteRole && (
                            <div class={styles["page-loader-role"]}>{siteRole}</div>
                        )}
                        <div class={styles["page-loader-name-wrap"]}>
                            <span class={styles["page-loader-name-base"]}>
                                <span>{siteFirstName}</span>
                                {siteLastName && (
                                    <span class={styles["page-loader-dot"]}>
                                        <Icon name="nm-sphere-white" />
                                    </span>
                                )}
                                {siteLastName && <span>{siteLastName}</span>}
                            </span>
                            <span
                                class={styles["page-loader-name-top"]}
                                data-loader="name-top"
                            >
                                <span>{siteFirstName}</span>
                                {siteLastName && (
                                    <span class={styles["page-loader-dot"]}>
                                        <Icon name="nm-sphere-white" />
                                    </span>
                                )}
                                {siteLastName && <span>{siteLastName}</span>}
                            </span>
                        </div>
                        <div class={styles["page-loader-text-wrap"]}>
                            <span
                                class={styles["page-loader-text"]}
                                data-loader-text="1"
                            >
                                Hold tight
                            </span>
                            <span
                                class={styles["page-loader-text"]}
                                data-loader-text="2"
                            >
                                Hi there!
                            </span>
                        </div>
                    </div>
                </div>
            )
        }
        <nav data-site-nav data-theme-nav>
            <a
                href="/"
                class={`${styles["nav-name"]} ${styles["nav-link"]}`}
                aria-current={isActive("/") ? "page" : undefined}
            >{siteName}<span class={styles["nav-link-line"]} data-nav-line aria-hidden="true" /></a>
        </nav>

        <div class={styles["page-meta"]}>
            <a
                href="/about"
                class={styles["nav-link"]}
                aria-current={isActive("/about") ? "page" : undefined}
            >About<span class={styles["nav-link-line"]} data-nav-line aria-hidden="true" /></a>
            {settings?.email && (
                <button
                    type="button"
                    aria-label="Copy email to clipboard"
                    data-copy-button
                    data-copy-email={settings.email}
                    class={styles["page-meta-link"]}
                >
                    <span class={styles["page-meta-text-wrap"]}>
                        <span class={styles["page-meta-text-el"]}>Email</span>
                        <span class={styles["page-meta-text-el"]}>Copy</span>
                        <span class={styles["page-meta-text-el"]}>Copied!</span>
                    </span>
                </button>
            )}
        </div>

        <main data-page-theme={pageTheme}>
            <slot />
        </main>

        <!-- CDN: Lenis, GSAP -->
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/CustomEase.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/SplitText.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
        ></script>

        <script is:inline>
            gsap.registerPlugin(CustomEase);
            if (typeof SplitText !== "undefined")
                gsap.registerPlugin(SplitText);
            if (typeof ScrollTrigger !== "undefined")
                gsap.registerPlugin(ScrollTrigger);

            var lenis = null;
            var hasLenis = typeof window.Lenis !== "undefined";

            var rmMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
            var reducedMotion = rmMQ.matches;
            rmMQ.addEventListener("change", function (e) {
                reducedMotion = e.matches;
            });

            // Skip splitting text in the Presentation iframe so stega markers survive
            // for click-to-edit. Iframe-only: the draft-mode cookie outlives the Studio
            // visit and would otherwise kill text animation sitewide.
            var isPreview =
                document.body.dataset.preview === "true" &&
                window.self !== window.top;

            CustomEase.create("osmo", "0.625, 0.05, 0, 1");
            gsap.defaults({ ease: "osmo" });

            // The loader covers the viewport, so the carousel can sit visible
            // underneath it instead of fading in once it's gone.
            var loaderWillPlay =
                !reducedMotion &&
                document.getElementById("page-loader") &&
                !sessionStorage.getItem("mai_loaded");

            if (!reducedMotion) {
                gsap.set(document.querySelectorAll(".nav__clip > *"), {
                    yPercent: 110,
                });
                gsap.set(document.querySelectorAll("[data-split]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-recognition-row]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-reveal]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-video-hero]"), {
                    autoAlpha: 0,
                    scale: 0.96,
                });
                gsap.set(document.querySelectorAll("[data-carousel-reveal]"), {
                    autoAlpha: loaderWillPlay ? 1 : 0,
                });
            }

            // -----------------------------------------
            // INITIAL PAGE LOAD
            // -----------------------------------------

            function init() {
                var navEl = document.querySelector("nav");
                if (navEl) {
                    document.documentElement.style.setProperty(
                        "--nav-h",
                        navEl.offsetHeight + "px",
                    );
                }

                initLenis();

                if (reducedMotion) {
                    gsap.set(
                        document.querySelectorAll(
                            "[data-split], [data-recognition-row], [data-reveal], [data-video-hero], [data-carousel-reveal]",
                        ),
                        { autoAlpha: 1 },
                    );
                    return;
                }

                animateNavIn();

                var isAbout = window.location.pathname.startsWith("/about");
                if (isAbout) {
                    initTextReveal(document.body);
                    initMediaReveal(document.body);
                    initRecognitionReveal(document.body);
                } else {
                    initTextReveal(document.body);
                    initMediaReveal(document.body);
                    initVideoHeroReveal(document.body);
                    if (!loaderWillPlay) {
                        initCarouselReveal(document.body);
                    }
                }

                window.maiReady = true;
                document.dispatchEvent(new CustomEvent("mai:ready"));
            }

            // -----------------------------------------
            // PAGE LOADER (homepage, first visit only)
            // -----------------------------------------

            function runLoader(onDone) {
                var loader = document.getElementById("page-loader");
                if (!loader) {
                    onDone();
                    return;
                }

                if (sessionStorage.getItem("mai_loaded")) {
                    gsap.set(loader, { display: "none" });
                    onDone();
                    return;
                }

                sessionStorage.setItem("mai_loaded", "1");

                if (reducedMotion) {
                    gsap.set(loader, { display: "none" });
                    onDone();
                    return;
                }

                CustomEase.create("loader", "0.65, 0.01, 0.05, 0.99");
                var bar = loader.querySelector("[data-loader='bar']");
                var bg = loader.querySelector("[data-loader='bg']");
                var content = loader.querySelector("[data-loader='content']");
                var nameTop = loader.querySelector("[data-loader='name-top']");
                var text1 = loader.querySelector("[data-loader-text='1']");
                var text2 = loader.querySelector("[data-loader-text='2']");

                if (!bar || !bg || !content || !nameTop || !text1 || !text2) {
                    onDone();
                    return;
                }

                var tl = gsap
                    .timeline({
                        defaults: { ease: "loader", duration: 3 },
                        onComplete: onDone,
                    })
                    .to(bar, { scaleX: 1 })
                    .to(nameTop, { clipPath: "inset(0% 0% 0% 0%)" }, "<")
                    .to(content, { autoAlpha: 0, duration: 0.5 })
                    .to(
                        bar,
                        {
                            scaleX: 0,
                            transformOrigin: "right center",
                            duration: 0.5,
                        },
                        "<",
                    )
                    .add("hideContent", "<")
                    .to(bg, { yPercent: -101, duration: 1 }, "hideContent")
                    .set(loader, { display: "none" });

                if (typeof SplitText !== "undefined") {
                    var split1 = new SplitText(text1, {
                        type: "lines,chars",
                        mask: "lines",
                    });
                    var split2 = new SplitText(text2, {
                        type: "lines,chars",
                        mask: "lines",
                    });
                    gsap.set([split1.chars, split2.chars], {
                        autoAlpha: 0,
                        yPercent: 125,
                    });
                    gsap.set([text1, text2], { autoAlpha: 1 });
                    tl.to(
                        split1.chars,
                        {
                            autoAlpha: 1,
                            yPercent: 0,
                            duration: 0.6,
                            stagger: { each: 0.02 },
                        },
                        0,
                    );
                    tl.to(
                        split1.chars,
                        {
                            autoAlpha: 0,
                            yPercent: -125,
                            duration: 0.4,
                            stagger: { each: 0.02 },
                        },
                        ">+=0.4",
                    );
                    tl.to(
                        split2.chars,
                        {
                            autoAlpha: 1,
                            yPercent: 0,
                            duration: 0.6,
                            stagger: { each: 0.02 },
                        },
                        "<",
                    );
                    tl.to(
                        split2.chars,
                        {
                            autoAlpha: 0,
                            yPercent: -125,
                            duration: 0.4,
                            stagger: { each: 0.02 },
                        },
                        "hideContent-=0.5",
                    );
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", function () {
                    runLoader(init);
                });
            } else {
                runLoader(init);
            }

            window.addEventListener("pageshow", function (e) {
                if (e.persisted) {
                    gsap.set(getNavAnimEls(), { yPercent: 110 });
                    animateNavIn();
                    // A bfcache restore can return the page mid-fade (animatePageOut
                    // leaves it at autoAlpha 0) and with its WebGL context dropped.
                    gsap.set(document.querySelectorAll("[data-carousel-reveal]"), { autoAlpha: 1 });
                    document.dispatchEvent(new CustomEvent("mai:pageshow-restored"));
                }
            });

            // -----------------------------------------
            // NAV ANIMATIONS
            // -----------------------------------------

            function getNavAnimEls() {
                return document.querySelectorAll(".nav__clip > *");
            }

            function animateNavIn() {
                if (reducedMotion) return;
                var els = getNavAnimEls();
                if (!els.length) return;
                gsap.to(els, {
                    yPercent: 0,
                    duration: 0.6,
                    stagger: 0.06,
                    ease: "expo.out",
                    overwrite: true,
                });
            }

            // -----------------------------------------
            // SPLIT TEXT REVEAL
            // -----------------------------------------

            var splitInstances = [];

            function initTextReveal(container) {
                if (typeof SplitText === "undefined") return;
                var scope = container || document;

                // Stega hides edit metadata in zero-width chars — invisible as text,
                // but SplitText lays each one out and shoves the visible text
                // off-centre. Stripping them costs click-to-edit, hence the skip above.
                if (!isPreview && document.body.dataset.preview === "true") {
                    scope.querySelectorAll("[data-split]").forEach(function (el) {
                        el.textContent = el.textContent.replace(
                            /[\u200B-\u200D\u2060\uFEFF]/g,
                            "",
                        );
                    });
                }

                scope
                    .querySelectorAll('[data-split="title"]')
                    .forEach(function (el) {
                        if (isPreview) {
                            gsap.set(el, { autoAlpha: 1 });
                            return;
                        }
                        if (reducedMotion) return;
                        splitInstances.push(
                            new SplitText(el, {
                                type: "words, chars",
                                autoSplit: true,
                                mask: "chars",
                                charsClass: "char",
                                onSplit: function (self) {
                                    gsap.set(self.elements, { autoAlpha: 1 });
                                    return gsap.from(self.chars, {
                                        duration: 1,
                                        yPercent: -120,
                                        scale: 1.2,
                                        stagger: 0.01,
                                        ease: "expo.out",
                                    });
                                },
                            }),
                        );
                    });

                scope
                    .querySelectorAll('[data-split="paragraph"]')
                    .forEach(function (el) {
                        if (isPreview) {
                            gsap.set(el, { autoAlpha: 1 });
                            return;
                        }
                        if (reducedMotion) return;
                        var delay = parseFloat(el.dataset.splitDelay || "0");
                        splitInstances.push(
                            new SplitText(el, {
                                type: "lines, words",
                                autoSplit: true,
                                mask: "lines",
                                linesClass: "line",
                                onSplit: function (self) {
                                    gsap.set(self.elements, { autoAlpha: 1 });
                                    return gsap.from(self.lines, {
                                        delay: delay,
                                        duration: 0.9,
                                        yPercent: 105,
                                        stagger: 0.04,
                                        ease: "expo.out",
                                        onComplete: function () {
                                            gsap.set(self.elements, {
                                                clearProps: "opacity",
                                            });
                                        },
                                    });
                                },
                            }),
                        );
                    });
            }

            function initMediaReveal(container) {
                if (reducedMotion) return;
                var els = (container || document).querySelectorAll(
                    "[data-reveal]",
                );
                if (!els.length) return;
                gsap.fromTo(
                    els,
                    { y: 16, autoAlpha: 0 },
                    {
                        y: 0,
                        autoAlpha: 1,
                        duration: 0.7,
                        ease: "power3.out",
                        stagger: 0.08,
                    },
                );
            }

            function initVideoHeroReveal(container) {
                if (reducedMotion) return;
                var el = (container || document).querySelector(
                    "[data-video-hero]",
                );
                if (!el) return;
                gsap.fromTo(
                    el,
                    { autoAlpha: 0, scale: 0.96 },
                    {
                        autoAlpha: 1,
                        scale: 1,
                        duration: 1.1,
                        delay: 0.15,
                        ease: "osmo",
                        clearProps: "scale",
                    },
                );
            }

            function initCarouselReveal(container) {
                if (reducedMotion) return;
                var el = (container || document).querySelector(
                    "[data-carousel-reveal]",
                );
                if (!el) return;
                // Opacity only: a y/scale tween fights the carousel's own rAF loop
                // and reads as a stutter.
                gsap.fromTo(
                    el,
                    { autoAlpha: 0 },
                    { autoAlpha: 1, duration: 0.6, delay: 0.15, ease: "power2.out" },
                );
            }

            function initRecognitionReveal(container) {
                if (reducedMotion) return;
                var rows = (container || document).querySelectorAll(
                    "[data-recognition-row]",
                );
                if (!rows.length) return;
                gsap.fromTo(
                    rows,
                    { autoAlpha: 0, y: 10 },
                    {
                        autoAlpha: 1,
                        y: 0,
                        duration: 0.6,
                        stagger: 0.04,
                        ease: "expo.out",
                        delay: 0.4,
                    },
                );
            }

            // -----------------------------------------
            // PAGE TRANSITIONS
            // -----------------------------------------

            function animatePageOut(onComplete) {
                if (reducedMotion) {
                    onComplete();
                    return;
                }

                var navEls = getNavAnimEls();
                var navLine = document.querySelector(
                    'a[aria-current="page"] [data-nav-line]',
                );
                var lines = document.querySelectorAll(
                    '[data-split="paragraph"] .line',
                );
                var chars = document.querySelectorAll(
                    '[data-split="title"] .char',
                );
                var rows = document.querySelectorAll("[data-recognition-row]");
                var media = document.querySelectorAll("[data-reveal]");
                var videoHero = document.querySelector("[data-video-hero]");
                var carousel = document.querySelector("[data-carousel-reveal]");

                if (
                    !navEls.length &&
                    !navLine &&
                    !chars.length &&
                    !lines.length &&
                    !rows.length &&
                    !media.length &&
                    !videoHero &&
                    !carousel
                ) {
                    onComplete();
                    return;
                }

                var tl = gsap.timeline({ onComplete: onComplete });

                if (navLine) {
                    navLine.style.animation = "none";
                    gsap.set(navLine, { scaleX: 1 });
                    tl.to(
                        navLine,
                        {
                            duration: 0.3,
                            ease: "power2.in",
                            scaleX: 0,
                            transformOrigin: "right center",
                        },
                        0,
                    );
                }

                if (navEls.length) {
                    tl.to(
                        navEls,
                        {
                            duration: 0.35,
                            yPercent: -110,
                            stagger: 0.06,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (chars.length) {
                    tl.to(
                        chars,
                        {
                            duration: 0.45,
                            yPercent: -120,
                            scale: 1.2,
                            stagger: 0.008,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (lines.length) {
                    tl.to(
                        lines,
                        {
                            duration: 0.45,
                            yPercent: 105,
                            stagger: 0.025,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (rows.length) {
                    tl.to(
                        rows,
                        {
                            duration: 0.3,
                            autoAlpha: 0,
                            y: -8,
                            stagger: 0.02,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (media.length) {
                    tl.to(
                        media,
                        {
                            duration: 0.35,
                            y: -8,
                            autoAlpha: 0,
                            stagger: 0.04,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (videoHero) {
                    tl.to(
                        videoHero,
                        {
                            duration: 0.4,
                            autoAlpha: 0,
                            scale: 0.98,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (carousel) {
                    // Opacity only — see initCarouselReveal for why.
                    tl.to(
                        carousel,
                        {
                            duration: 0.35,
                            autoAlpha: 0,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
            }

            document.addEventListener("click", function (e) {
                var link = e.target.closest("a[href]");
                if (!link) return;
                var href = link.getAttribute("href");
                if (
                    !href ||
                    href.startsWith("http") ||
                    href.startsWith("//") ||
                    href.startsWith("mailto") ||
                    href.startsWith("#") ||
                    link.target === "_blank"
                )
                    return;
                e.preventDefault();
                var clickedNavLine = link.querySelector("[data-nav-line]");
                if (clickedNavLine) {
                    // Pin it so it can't drop back out mid-navigation.
                    clickedNavLine.style.transform = "scaleX(1)";
                }
                animatePageOut(function () {
                    window.location.href = href;
                });
            });

            // -----------------------------------------
            // EMAIL COPY
            // -----------------------------------------

            (function initEmailCopy() {
                var button = document.querySelector("[data-copy-email]");
                if (!button) return;

                var resetTimer = null;

                function copyEmail() {
                    var email = button.getAttribute("data-copy-email");
                    if (!email) return;
                    navigator.clipboard.writeText(email).then(function () {
                        button.setAttribute("data-copy-button", "copied");
                        button.setAttribute(
                            "aria-label",
                            "Email copied to clipboard!",
                        );
                        clearTimeout(resetTimer);
                        resetTimer = setTimeout(function () {
                            button.removeAttribute("data-copy-button");
                            button.setAttribute(
                                "aria-label",
                                "Copy email to clipboard",
                            );
                        }, 2000);
                    });
                }

                button.addEventListener("click", function (e) {
                    e.preventDefault();
                    copyEmail();
                });
                button.addEventListener("keydown", function (e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        copyEmail();
                    }
                });
            })();

            // -----------------------------------------
            // HELPERS
            // -----------------------------------------

            function initLenis() {
                if (lenis || !hasLenis) return;
                lenis = new Lenis({ lerp: 0.165, wheelMultiplier: 1.25 });
                if (typeof ScrollTrigger !== "undefined") {
                    lenis.on("scroll", ScrollTrigger.update);
                }
                gsap.ticker.add(function (time) {
                    lenis.raf(time * 1000);
                });
                gsap.ticker.lagSmoothing(0);
            }
        </script>
        {preview && <VisualEditing client:only="react" />}
    </body>
</html>
