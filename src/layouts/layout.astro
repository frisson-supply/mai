---
import "@/global.css";
import styles from "./layout.module.css";
import { getSiteSettings } from "@/lib/queries";
import Icon from "@/components/icon/icon.astro";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    namespace?: string;
    pageTheme?: "light" | "dark";
}

const {
    title = "Mai",
    description,
    ogImage,
    namespace,
    pageTheme = "dark",
} = Astro.props;
const path = Astro.url.pathname;
const showBack = path !== "/";
const settings = await getSiteSettings();

const siteName = settings?.siteTitle ?? "Mai";
const siteNameParts = siteName.split(" ");
const siteFirstName = siteNameParts[0];
const siteLastName = siteNameParts.slice(1).join(" ") || "";
const siteRole = settings?.role ?? "";
const siteLocation = settings?.location ?? "";

function isActive(href: string) {
    if (href === "/") return path === "/";
    return path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        {
            settings?.faviconUrl ? (
                <link rel="icon" href={settings.faviconUrl} />
            ) : (
                <link rel="icon" href="/favicon.svg" />
            )
        }
        {description && <meta name="description" content={description} />}
        <meta property="og:title" content={title} />
        {
            description && (
                <meta property="og:description" content={description} />
            )
        }
        {(ogImage ?? settings?.ogImageUrl) && <meta property="og:image" content={ogImage ?? settings?.ogImageUrl} />}
        <meta property="og:type" content="website" />
        <meta
            name="twitter:card"
            content={(ogImage ?? settings?.ogImageUrl) ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={title} />
        {
            description && (
                <meta name="twitter:description" content={description} />
            )
        }
        {(ogImage ?? settings?.ogImageUrl) && <meta name="twitter:image" content={ogImage ?? settings?.ogImageUrl} />}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/CustomEase.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/SplitText.min.js" />
        <link rel="preload" as="script" href="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/Flip.min.js" />
        <script is:inline>
            if (
                typeof sessionStorage !== "undefined" &&
                sessionStorage.getItem("mai_loaded")
            ) {
                document.documentElement.classList.add("loader-done");
            }
        </script>
    </head>
    <body data-page-theme={pageTheme} data-namespace={namespace}>
        {
            path === "/" && (
                <div id="page-loader" class={styles["page-loader"]}>
                    <div class={styles["page-loader__bg"]} data-loader="bg">
                        <div
                            class={styles["page-loader__bar"]}
                            data-loader="bar"
                        />
                    </div>
                    <div
                        class={styles["page-loader__content"]}
                        data-loader="content"
                    >
                        <div class={styles["page-loader__name-wrap"]}>
                            <span class={styles["page-loader__name-base"]}>
                                {siteFirstName}
                                {siteLastName && (
                                    <span class={styles["page-loader__dot"]}>
                                        <Icon name="nm-sphere-white" />
                                    </span>
                                )}
                                {siteLastName}
                            </span>
                            <span
                                class={styles["page-loader__name-top"]}
                                data-loader="name-top"
                            >
                                {siteFirstName}
                                {siteLastName && (
                                    <span class={styles["page-loader__dot"]}>
                                        <Icon name="nm-sphere-white" />
                                    </span>
                                )}
                                {siteLastName}
                            </span>
                        </div>
                        <div class={styles["page-loader__text-wrap"]}>
                            <span
                                class={styles["page-loader__text"]}
                                data-loader-text="1"
                            >
                                Hold tight
                            </span>
                            <span
                                class={styles["page-loader__text"]}
                                data-loader-text="2"
                            >
                                Hi there!
                            </span>
                        </div>
                    </div>
                </div>
            )
        }
        <nav data-site-nav data-theme-nav>
            <a
                href="/"
                class={styles["nav__name"]}
                aria-current={isActive("/") ? "page" : undefined}
            >
                {siteName}
            </a>
            <div class={styles["nav__col"]}>
                <a
                    href="/about"
                    class={styles["nav__link"]}
                    aria-current={isActive("/about") ? "page" : undefined}
                >About<span class={styles["nav__link-line"]} data-nav-line aria-hidden="true" /></a>
            </div>
        </nav>

        <div class={styles["page-meta"]}>
            {
                !showBack ? (
                    <>
                        {siteRole && (
                            <>
                                <span data-split="title" aria-hidden="true">{siteRole}</span>
                                <span class="sr-only">{siteRole}</span>
                            </>
                        )}
                        {siteLocation && (
                            <>
                                <span data-split="title" aria-hidden="true">{siteLocation}</span>
                                <span class="sr-only">{siteLocation}</span>
                            </>
                        )}
                    </>
                ) : (
                    <a href="/" class={styles["page-meta__link"]}>
                        <span data-split="title">←</span>{" "}
                        <span data-split="title" data-split-delay="0.08">
                            Back
                        </span>
                    </a>
                )
            }
        </div>

        <main data-page-theme={pageTheme}>
            <slot />
        </main>

        <!-- CDN: Lenis, GSAP -->
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/CustomEase.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/SplitText.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/Flip.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
        ></script>

        <script is:inline>
            gsap.registerPlugin(CustomEase);
            if (typeof Flip !== "undefined") gsap.registerPlugin(Flip);
            if (typeof SplitText !== "undefined")
                gsap.registerPlugin(SplitText);
            if (typeof ScrollTrigger !== "undefined")
                gsap.registerPlugin(ScrollTrigger);

            var lenis = null;
            var hasLenis = typeof window.Lenis !== "undefined";

            var rmMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
            var reducedMotion = rmMQ.matches;
            rmMQ.addEventListener("change", function (e) {
                reducedMotion = e.matches;
            });

            CustomEase.create("osmo", "0.625, 0.05, 0, 1");
            gsap.defaults({ ease: "osmo" });

            if (!reducedMotion) {
                gsap.set(document.querySelectorAll(".nav__clip > *"), {
                    yPercent: 110,
                });
                gsap.set(document.querySelectorAll("[data-split]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-recognition-row]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-work-item]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-reveal]"), {
                    autoAlpha: 0,
                });
                gsap.set(document.querySelectorAll("[data-video-hero]"), {
                    autoAlpha: 0,
                    scale: 0.96,
                });
            }

            // -----------------------------------------
            // INITIAL PAGE LOAD
            // -----------------------------------------

            function init() {
                var navEl = document.querySelector("nav");
                if (navEl) {
                    document.documentElement.style.setProperty(
                        "--nav-h",
                        navEl.offsetHeight + "px",
                    );
                }

                initLenis();
                initWorkView();

                if (reducedMotion) {
                    gsap.set(
                        document.querySelectorAll(
                            "[data-split], [data-recognition-row], [data-work-item], [data-reveal], [data-video-hero]",
                        ),
                        { autoAlpha: 1 },
                    );
                    return;
                }

                animateNavIn();

                var isAbout = window.location.pathname.startsWith("/about");
                if (isAbout) {
                    initTextReveal(document.body);
                    initMediaReveal(document.body);
                    initRecognitionReveal(document.body);
                } else {
                    initTextReveal(document.body);
                    initMediaReveal(document.body);
                    initVideoHeroReveal(document.body);
                    initWorkItemReveal(document.body, initInfoSplits);
                }

                document.dispatchEvent(new CustomEvent("mai:ready"));
            }

            // -----------------------------------------
            // PAGE LOADER (homepage, first visit only)
            // -----------------------------------------

            function runLoader(onDone) {
                var loader = document.getElementById("page-loader");
                if (!loader) {
                    onDone();
                    return;
                }

                if (sessionStorage.getItem("mai_loaded")) {
                    gsap.set(loader, { display: "none" });
                    onDone();
                    return;
                }

                sessionStorage.setItem("mai_loaded", "1");

                if (reducedMotion) {
                    gsap.set(loader, { display: "none" });
                    onDone();
                    return;
                }

                CustomEase.create("loader", "0.65, 0.01, 0.05, 0.99");
                var bar = loader.querySelector("[data-loader='bar']");
                var bg = loader.querySelector("[data-loader='bg']");
                var content = loader.querySelector("[data-loader='content']");
                var nameTop = loader.querySelector("[data-loader='name-top']");
                var text1 = loader.querySelector("[data-loader-text='1']");
                var text2 = loader.querySelector("[data-loader-text='2']");

                if (!bar || !bg || !content || !nameTop || !text1 || !text2) {
                    onDone();
                    return;
                }

                var tl = gsap
                    .timeline({
                        defaults: { ease: "loader", duration: 3 },
                        onComplete: onDone,
                    })
                    .to(bar, { scaleX: 1 })
                    .to(nameTop, { clipPath: "inset(0% 0% 0% 0%)" }, "<")
                    .to(content, { autoAlpha: 0, duration: 0.5 })
                    .to(
                        bar,
                        {
                            scaleX: 0,
                            transformOrigin: "right center",
                            duration: 0.5,
                        },
                        "<",
                    )
                    .add("hideContent", "<")
                    .to(bg, { yPercent: -101, duration: 1 }, "hideContent")
                    .set(loader, { display: "none" });

                if (typeof SplitText !== "undefined") {
                    var split1 = new SplitText(text1, {
                        type: "lines,chars",
                        mask: "lines",
                    });
                    var split2 = new SplitText(text2, {
                        type: "lines,chars",
                        mask: "lines",
                    });
                    gsap.set([split1.chars, split2.chars], {
                        autoAlpha: 0,
                        yPercent: 125,
                    });
                    gsap.set([text1, text2], { autoAlpha: 1 });
                    tl.to(
                        split1.chars,
                        {
                            autoAlpha: 1,
                            yPercent: 0,
                            duration: 0.6,
                            stagger: { each: 0.02 },
                        },
                        0,
                    );
                    tl.to(
                        split1.chars,
                        {
                            autoAlpha: 0,
                            yPercent: -125,
                            duration: 0.4,
                            stagger: { each: 0.02 },
                        },
                        ">+=0.4",
                    );
                    tl.to(
                        split2.chars,
                        {
                            autoAlpha: 1,
                            yPercent: 0,
                            duration: 0.6,
                            stagger: { each: 0.02 },
                        },
                        "<",
                    );
                    tl.to(
                        split2.chars,
                        {
                            autoAlpha: 0,
                            yPercent: -125,
                            duration: 0.4,
                            stagger: { each: 0.02 },
                        },
                        "hideContent-=0.5",
                    );
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", function () {
                    runLoader(init);
                });
            } else {
                runLoader(init);
            }

            window.addEventListener("pageshow", function (e) {
                if (e.persisted) {
                    gsap.set(getNavAnimEls(), { yPercent: 110 });
                    animateNavIn();
                }
            });

            // -----------------------------------------
            // NAV ANIMATIONS
            // -----------------------------------------

            function getNavAnimEls() {
                return document.querySelectorAll(".nav__clip > *");
            }

            function animateNavIn() {
                if (reducedMotion) return;
                var els = getNavAnimEls();
                if (!els.length) return;
                gsap.to(els, {
                    yPercent: 0,
                    duration: 0.6,
                    stagger: 0.06,
                    ease: "expo.out",
                    overwrite: true,
                });
            }

            // -----------------------------------------
            // SPLIT TEXT REVEAL
            // -----------------------------------------

            var splitInstances = [];

            function initTextReveal(container) {
                if (typeof SplitText === "undefined") return;
                var scope = container || document;

                scope
                    .querySelectorAll('[data-split="title"]')
                    .forEach(function (el) {
                        if (reducedMotion) return;
                        splitInstances.push(
                            new SplitText(el, {
                                type: "words, chars",
                                autoSplit: true,
                                mask: "chars",
                                charsClass: "char",
                                onSplit: function (self) {
                                    gsap.set(self.elements, { autoAlpha: 1 });
                                    return gsap.from(self.chars, {
                                        duration: 1,
                                        yPercent: -120,
                                        scale: 1.2,
                                        stagger: 0.01,
                                        ease: "expo.out",
                                    });
                                },
                            }),
                        );
                    });

                scope
                    .querySelectorAll('[data-split="paragraph"]')
                    .forEach(function (el) {
                        if (reducedMotion) return;
                        var delay = parseFloat(el.dataset.splitDelay || "0");
                        splitInstances.push(
                            new SplitText(el, {
                                type: "lines, words",
                                autoSplit: true,
                                mask: "lines",
                                linesClass: "line",
                                onSplit: function (self) {
                                    gsap.set(self.elements, { autoAlpha: 1 });
                                    return gsap.from(self.lines, {
                                        delay: delay,
                                        duration: 0.9,
                                        yPercent: 105,
                                        stagger: 0.04,
                                        ease: "expo.out",
                                        onComplete: function () {
                                            gsap.set(self.elements, {
                                                clearProps: "opacity",
                                            });
                                        },
                                    });
                                },
                            }),
                        );
                    });
            }

            function initWorkItemReveal(container, onComplete) {
                if (reducedMotion) {
                    if (onComplete) onComplete();
                    return;
                }
                var items = (container || document).querySelectorAll(
                    "[data-work-item]",
                );
                if (!items.length) {
                    if (onComplete) onComplete();
                    return;
                }
                gsap.fromTo(
                    items,
                    { y: 16, autoAlpha: 0 },
                    {
                        y: 0,
                        autoAlpha: 1,
                        duration: 0.7,
                        ease: "power3.out",
                        stagger: 0.06,
                        onComplete: onComplete || null,
                    },
                );
            }

            var infoLines = [];
            var listWidthRafId = null;

            function initInfoSplits() {
                if (typeof SplitText === "undefined" || reducedMotion) return;
                infoLines = [];
                document
                    .querySelectorAll("[data-work-line]")
                    .forEach(function (el) {
                        var s = new SplitText(el, {
                            type: "lines, words",
                            mask: "lines",
                        });
                        infoLines = infoLines.concat(Array.from(s.lines));
                    });
            }

            function initMediaReveal(container) {
                if (reducedMotion) return;
                var els = (container || document).querySelectorAll(
                    "[data-reveal]",
                );
                if (!els.length) return;
                gsap.fromTo(
                    els,
                    { y: 16, autoAlpha: 0 },
                    {
                        y: 0,
                        autoAlpha: 1,
                        duration: 0.7,
                        ease: "power3.out",
                        stagger: 0.08,
                    },
                );
            }

            function initVideoHeroReveal(container) {
                if (reducedMotion) return;
                var el = (container || document).querySelector(
                    "[data-video-hero]",
                );
                if (!el) return;
                gsap.fromTo(
                    el,
                    { autoAlpha: 0, scale: 0.96 },
                    {
                        autoAlpha: 1,
                        scale: 1,
                        duration: 1.1,
                        delay: 0.15,
                        ease: "osmo",
                        clearProps: "scale",
                    },
                );
            }

            function initRecognitionReveal(container) {
                if (reducedMotion) return;
                var rows = (container || document).querySelectorAll(
                    "[data-recognition-row]",
                );
                if (!rows.length) return;
                gsap.fromTo(
                    rows,
                    { autoAlpha: 0, y: 10 },
                    {
                        autoAlpha: 1,
                        y: 0,
                        duration: 0.6,
                        stagger: 0.04,
                        ease: "expo.out",
                        delay: 0.4,
                    },
                );
            }

            function startListWidthRaf(section, items, getHoveredItem) {
                stopListWidthRaf();

                var currentWidths = new Map();
                items.forEach(function (item) {
                    currentWidths.set(item, item.getBoundingClientRect().width);
                });

                function tick() {
                    var vh = window.innerHeight;
                    var centerY = vh * 0.5;
                    items.forEach(function (item) {
                        var rect = item.getBoundingClientRect();
                        var itemCenter = rect.top + rect.height * 0.5;
                        var dist = Math.abs(itemCenter - centerY);
                        var maxDist = vh * 0.6;
                        var t = Math.max(0, 1 - dist / maxDist);
                        t = t * t * (3 - 2 * t); // smoothstep
                        var targetW = 400 + 200 * t;
                        var currentW = currentWidths.get(item) || targetW;
                        currentW = currentW + (targetW - currentW) * 0.12;
                        currentWidths.set(item, currentW);
                        item.style.width =
                            "min(" + Math.round(currentW) + "px, 100%)";
                    });
                    listWidthRafId = requestAnimationFrame(tick);
                }
                listWidthRafId = requestAnimationFrame(tick);
            }

            function stopListWidthRaf() {
                if (listWidthRafId) {
                    cancelAnimationFrame(listWidthRafId);
                    listWidthRafId = null;
                }
            }

            // -----------------------------------------
            // WORK VIEW TOGGLE
            // -----------------------------------------

            document.addEventListener("click", function (e) {
                var btn = e.target.closest("[data-view-btn]");
                if (!btn) return;
                applyWorkView(btn.dataset.viewBtn);
            });

            function applyWorkView(view, instant) {
                var section = document.getElementById("work-section");
                var layout = document.getElementById("work-layout");
                var items = document.querySelectorAll("[data-work-item]");
                var thumbs = document.querySelectorAll("[data-work-thumb]");
                var names = document.querySelectorAll("[data-work-list-name]");
                var nameTexts = document.querySelectorAll(
                    "[data-work-list-text]",
                );
                var toGrid = view === "grid";

                var flipState =
                    !instant &&
                    !reducedMotion &&
                    typeof Flip !== "undefined" &&
                    items.length
                        ? Flip.getState([
                              ...Array.from(items),
                              ...Array.from(thumbs),
                          ])
                        : null;

                stopListWidthRaf();
                items.forEach(function (item) {
                    item.style.removeProperty("width");
                });

                if (flipState) {
                    if (!toGrid && infoLines.length) {
                        // Leaving grid: slide info lines behind mask
                        gsap.to(infoLines, {
                            yPercent: 105,
                            duration: 0.25,
                            ease: "power2.in",
                            stagger: 0.02,
                            overwrite: true,
                        });
                    }
                    // Pre-hide name texts so they don't flash visible when the
                    // list panel becomes CSS-visible on the next line
                    if (!toGrid && nameTexts.length) {
                        gsap.set(nameTexts, { yPercent: 105 });
                    }

                }

                if (toGrid && flipState) {
                    document.body.style.minHeight =
                        document.body.scrollHeight + "px";
                    if (lenis) lenis.scrollTo(0, { duration: 0.7 });
                }

                if (section) section.dataset.view = view;
                if (layout) layout.dataset.view = view;
                localStorage.setItem("workView", view);
                document
                    .querySelectorAll("[data-view-btn]")
                    .forEach(function (btn) {
                        btn.classList.toggle(
                            "is-active",
                            btn.dataset.viewBtn === view,
                        );
                    });

                if (flipState) {
                    if (toGrid && infoLines.length) {
                        gsap.set(infoLines, { yPercent: 105, overwrite: true });
                    }
                    // Clean up active state when returning to grid
                    if (toGrid) {
                        if (section) section.classList.remove("has-active");
                        items.forEach(function (item) {
                            item.classList.remove("is-active");
                        });
                    }

                    if (section) section.style.overflow = "visible";
                    items.forEach(function (item) {
                        item.style.overflow = "visible";
                    });

                    Flip.from(flipState, {
                        duration: 0.55,
                        ease: "power3.inOut",
                        stagger: 0.04,
                        nested: true,
                        onComplete: function () {
                            if (toGrid) {
                                if (lenis)
                                    lenis.scrollTo(0, { immediate: true });
                                else window.scrollTo(0, 0);
                                document.body.style.removeProperty(
                                    "min-height",
                                );
                            }
                            if (section)
                                section.style.removeProperty("overflow");
                            items.forEach(function (item) {
                                item.style.removeProperty("overflow");
                            });
                            if (toGrid && infoLines.length) {
                                // Entering grid: reveal info lines from mask
                                gsap.to(infoLines, {
                                    yPercent: 0,
                                    duration: 0.55,
                                    ease: "expo.out",
                                    stagger: 0.03,
                                    overwrite: true,
                                });
                            }
                            if (!toGrid && nameTexts.length) {
                                // Entering list: reveal name texts (already hidden by gsap.set above)
                                gsap.to(nameTexts, {
                                    yPercent: 0,
                                    duration: 0.9,
                                    ease: "expo.out",
                                    stagger: 0.04,
                                    overwrite: true,
                                });
                            }
                            initListHover();
                        },
                    });
                } else {
                    initListHover();
                }
            }

            function initListHover() {
                var section = document.getElementById("work-section");

                if (section && section._scrollObserver) {
                    section._scrollObserver.disconnect();
                    section._scrollObserver = null;
                }
                stopListWidthRaf();

                if (!section || section.dataset.view !== "list") return;

                var items = section.querySelectorAll("[data-work-item]");
                var names = document.querySelectorAll("[data-work-list-name]");
                var isHovering = false;
                var hoveredItem = null;
                var visibilityMap = new Map();

                function setActive(itemEl) {
                    var slug = itemEl.dataset.projectSlug;
                    section.classList.add("has-active");
                    items.forEach(function (el) {
                        el.classList.toggle("is-active", el === itemEl);
                    });
                    names.forEach(function (el) {
                        el.classList.toggle(
                            "is-active",
                            el.dataset.projectSlug === slug,
                        );
                    });
                }

                function clearActive() {
                    section.classList.remove("has-active");
                    items.forEach(function (el) {
                        el.classList.remove("is-active");
                    });
                    names.forEach(function (el) {
                        el.classList.remove("is-active");
                    });
                }

                function applyScrollActive() {
                    var best = null;
                    var bestRatio = 0;
                    visibilityMap.forEach(function (ratio, el) {
                        if (ratio > bestRatio) {
                            bestRatio = ratio;
                            best = el;
                        }
                    });
                    if (best && bestRatio > 0) {
                        setActive(best);
                    } else {
                        clearActive();
                    }
                }

                items.forEach(function (el) {
                    el.addEventListener("mouseenter", function () {
                        isHovering = true;
                        hoveredItem = el;
                        setActive(el);
                    });
                    el.addEventListener("mouseleave", function () {
                        isHovering = false;
                        hoveredItem = null;
                        applyScrollActive();
                    });
                });
                names.forEach(function (el) {
                    el.addEventListener("mouseenter", function () {
                        isHovering = true;
                        var matchingItem = Array.from(items).find(
                            function (it) {
                                return (
                                    it.dataset.projectSlug ===
                                    el.dataset.projectSlug
                                );
                            },
                        );
                        hoveredItem = matchingItem || null;
                        if (matchingItem) setActive(matchingItem);
                    });
                    el.addEventListener("mouseleave", function () {
                        isHovering = false;
                        hoveredItem = null;
                        applyScrollActive();
                    });
                });

                var observer = new IntersectionObserver(
                    function (entries) {
                        entries.forEach(function (entry) {
                            visibilityMap.set(
                                entry.target,
                                entry.intersectionRatio,
                            );
                        });
                        if (!isHovering) {
                            applyScrollActive();
                        }
                    },
                    {
                        rootMargin: "-10% 0px -10% 0px",
                        threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
                    },
                );

                items.forEach(function (el) {
                    observer.observe(el);
                });
                section._scrollObserver = observer;

                startListWidthRaf(section, items, function () {
                    return hoveredItem;
                });
            }

            function initWorkView() {
                var section = document.getElementById("work-section");
                if (!section) return;
                var view = reducedMotion
                    ? "grid"
                    : localStorage.getItem("workView") || "grid";
                applyWorkView(view, true);
            }

            // -----------------------------------------
            // PAGE TRANSITIONS
            // -----------------------------------------

            function animatePageOut(onComplete) {
                if (reducedMotion) {
                    onComplete();
                    return;
                }

                var navEls = getNavAnimEls();
                var navLine = document.querySelector(
                    'nav a[aria-current="page"] [data-nav-line]',
                );
                var lines = document.querySelectorAll(
                    '[data-split="paragraph"] .line',
                );
                var chars = document.querySelectorAll(
                    '[data-split="title"] .char',
                );
                var rows = document.querySelectorAll("[data-recognition-row]");
                var items = document.querySelectorAll("[data-work-item]");
                var media = document.querySelectorAll("[data-reveal]");
                var nameTexts = document.querySelectorAll(
                    "[data-work-list-text]",
                );
                var videoHero = document.querySelector("[data-video-hero]");

                if (
                    !navEls.length &&
                    !navLine &&
                    !chars.length &&
                    !lines.length &&
                    !rows.length &&
                    !items.length &&
                    !media.length &&
                    !nameTexts.length &&
                    !videoHero
                ) {
                    onComplete();
                    return;
                }

                var tl = gsap.timeline({ onComplete: onComplete });

                if (navLine) {
                    navLine.style.animation = "none";
                    gsap.set(navLine, { scaleX: 1 });
                    tl.to(
                        navLine,
                        {
                            duration: 0.3,
                            ease: "power2.in",
                            scaleX: 0,
                            transformOrigin: "right center",
                        },
                        0,
                    );
                }

                if (navEls.length) {
                    tl.to(
                        navEls,
                        {
                            duration: 0.35,
                            yPercent: -110,
                            stagger: 0.06,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (chars.length) {
                    tl.to(
                        chars,
                        {
                            duration: 0.45,
                            yPercent: -120,
                            scale: 1.2,
                            stagger: 0.008,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (lines.length) {
                    tl.to(
                        lines,
                        {
                            duration: 0.45,
                            yPercent: 105,
                            stagger: 0.025,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (rows.length) {
                    tl.to(
                        rows,
                        {
                            duration: 0.3,
                            autoAlpha: 0,
                            y: -8,
                            stagger: 0.02,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (items.length) {
                    tl.to(
                        items,
                        {
                            duration: 0.35,
                            y: -8,
                            autoAlpha: 0,
                            stagger: 0.03,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (nameTexts.length) {
                    tl.to(
                        nameTexts,
                        {
                            duration: 0.45,
                            yPercent: 105,
                            stagger: 0.025,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (media.length) {
                    tl.to(
                        media,
                        {
                            duration: 0.35,
                            y: -8,
                            autoAlpha: 0,
                            stagger: 0.04,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (videoHero) {
                    tl.to(
                        videoHero,
                        {
                            duration: 0.4,
                            autoAlpha: 0,
                            scale: 0.98,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
            }

            document.addEventListener("click", function (e) {
                var link = e.target.closest("a[href]");
                if (!link) return;
                var href = link.getAttribute("href");
                if (
                    !href ||
                    href.startsWith("http") ||
                    href.startsWith("//") ||
                    href.startsWith("mailto") ||
                    href.startsWith("#") ||
                    link.target === "_blank"
                )
                    return;
                e.preventDefault();
                animatePageOut(function () {
                    window.location.href = href;
                });
            });

            // -----------------------------------------
            // HELPERS
            // -----------------------------------------

            function initLenis() {
                if (lenis || !hasLenis) return;
                lenis = new Lenis({ lerp: 0.165, wheelMultiplier: 1.25 });
                if (typeof ScrollTrigger !== "undefined") {
                    lenis.on("scroll", ScrollTrigger.update);
                }
                gsap.ticker.add(function (time) {
                    lenis.raf(time * 1000);
                });
                gsap.ticker.lagSmoothing(0);
            }
        </script>
    </body>
</html>
