---
import "../styles/global.css";
import { getSiteSettings } from "../lib/queries";

interface Props {
    title?: string;
    // namespace: string;
    pageTheme?: "light" | "dark";
}

const { title = "Mai", pageTheme = "dark" } = Astro.props;
const path = Astro.url.pathname;
const showBack = path !== "/";
const settings = await getSiteSettings();

const siteName = settings?.siteTitle ?? "Mai";
const siteRole = settings?.role ?? "";
const siteLocation = settings?.location ?? "";

function isActive(href: string) {
    if (href === "/") return path === "/";
    return path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <script is:inline>
            if (typeof sessionStorage !== "undefined" && sessionStorage.getItem("mai_loaded")) {
                document.documentElement.classList.add("loader-done");
            }
        </script>
    </head>
    <body data-page-theme={pageTheme}>
        {path === "/" && (
            <div id="page-loader" class="page-loader">
                <div class="page-loader__bg">
                    <div class="page-loader__bar"></div>
                </div>
                <div class="page-loader__content">
                    <div class="page-loader__name-wrap">
                        <span class="page-loader__name-base">{siteName}</span>
                        <span class="page-loader__name-top">{siteName}</span>
                    </div>
                    <div class="page-loader__text-wrap">
                        <span class="page-loader__text page-loader__text--1">Hold tight</span>
                        <span class="page-loader__text page-loader__text--2">Hi there!</span>
                    </div>
                </div>
            </div>
        )}
        <nav data-theme-nav>
            <a
                href="/"
                class="nav__name"
                aria-current={isActive("/") ? "page" : undefined}
            >
                {siteName}
            </a>
            <div class="nav__col">
                <a href="/about" class="nav__link">About</a>
            </div>
        </nav>

        <div class="page-meta">
            {!showBack ? (
                <>
                    <a
                        href="/contact"
                        class="page-meta__link"
                        aria-current={isActive("/contact") ? "page" : undefined}
                        data-split="paragraph"
                    >Contact</a>
                    {siteRole && <span data-split="paragraph">{siteRole}</span>}
                    {siteLocation && <span data-split="paragraph">{siteLocation}</span>}
                </>
            ) : (
                <a href="/" class="page-meta__link" data-split="paragraph">← Back</a>
            )}
        </div>

        <main data-page-theme={pageTheme}>
            <slot />
        </main>

        <!-- CDN: Lenis, GSAP -->
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/CustomEase.min.js"
        ></script>
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/SplitText.min.js"
        ></script>

        <script is:inline>
            gsap.registerPlugin(CustomEase);
            if (typeof SplitText !== "undefined")
                gsap.registerPlugin(SplitText);

            var lenis = null;
            var hasLenis = typeof window.Lenis !== "undefined";

            var rmMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
            var reducedMotion = rmMQ.matches;
            rmMQ.addEventListener("change", function (e) {
                reducedMotion = e.matches;
            });

            CustomEase.create("osmo", "0.625, 0.05, 0, 1");
            gsap.defaults({ ease: "osmo" });

            gsap.set(document.querySelectorAll(".nav__clip > *"), {
                yPercent: 110,
            });
            gsap.set(document.querySelectorAll("[data-split]"), {
                autoAlpha: 0,
            });
            gsap.set(document.querySelectorAll("[data-recognition-row]"), {
                autoAlpha: 0,
            });
            gsap.set(document.querySelectorAll(".work-item"), { autoAlpha: 0 });
            gsap.set(
                document.querySelectorAll(
                    ".image-block, .video-section, .text-image-block__image",
                ),
                { autoAlpha: 0 },
            );

            // -----------------------------------------
            // INITIAL PAGE LOAD
            // -----------------------------------------

            function init() {
                var navEl = document.querySelector("nav");
                if (navEl) {
                    document.documentElement.style.setProperty(
                        "--nav-h",
                        navEl.offsetHeight + "px",
                    );
                }

                initLenis();
                initWorkView();
                animateNavIn();

                var isAbout = window.location.pathname.startsWith("/about");
                if (isAbout) {
                    initTextReveal(document.body);
                    initMediaReveal(document.body);
                    initRecognitionReveal(document.body);
                } else {
                    initTextReveal(document.body);
                    initMediaReveal(document.body);
                    initWorkItemReveal(document.body);
                }
            }

            // -----------------------------------------
            // PAGE LOADER (homepage, first visit only)
            // -----------------------------------------

            function runLoader(onDone) {
                var loader = document.getElementById("page-loader");
                if (!loader) { onDone(); return; }

                if (sessionStorage.getItem("mai_loaded")) {
                    gsap.set(loader, { display: "none" });
                    onDone();
                    return;
                }

                sessionStorage.setItem("mai_loaded", "1");

                CustomEase.create("loader", "0.65, 0.01, 0.05, 0.99");
                var bar     = loader.querySelector(".page-loader__bar");
                var bg      = loader.querySelector(".page-loader__bg");
                var content = loader.querySelector(".page-loader__content");
                var nameTop = loader.querySelector(".page-loader__name-top");
                var text1   = loader.querySelector(".page-loader__text--1");
                var text2   = loader.querySelector(".page-loader__text--2");

                if (!bar || !bg || !content || !nameTop || !text1 || !text2) {
                    onDone();
                    return;
                }

                var tl = gsap.timeline({
                    defaults: { ease: "loader", duration: 3 },
                    onComplete: onDone
                })
                .to(bar, { scaleX: 1 })
                .to(nameTop, { clipPath: "inset(0% 0% 0% 0%)" }, "<")
                .to(content, { autoAlpha: 0, duration: 0.5 })
                .to(bar, { scaleX: 0, transformOrigin: "right center", duration: 0.5 }, "<")
                .add("hideContent", "<")
                .to(bg, { yPercent: -101, duration: 1 }, "hideContent")
                .set(loader, { display: "none" });

                if (typeof SplitText !== "undefined") {
                    var split1 = new SplitText(text1, { type: "lines,chars", mask: "lines" });
                    var split2 = new SplitText(text2, { type: "lines,chars", mask: "lines" });
                    gsap.set([split1.chars, split2.chars], { autoAlpha: 0, yPercent: 125 });
                    gsap.set([text1, text2], { autoAlpha: 1 });
                    tl.to(split1.chars, { autoAlpha: 1, yPercent: 0, duration: 0.6, stagger: { each: 0.02 } }, 0);
                    tl.to(split1.chars, { autoAlpha: 0, yPercent: -125, duration: 0.4, stagger: { each: 0.02 } }, ">+=0.4");
                    tl.to(split2.chars, { autoAlpha: 1, yPercent: 0, duration: 0.6, stagger: { each: 0.02 } }, "<");
                    tl.to(split2.chars, { autoAlpha: 0, yPercent: -125, duration: 0.4, stagger: { each: 0.02 } }, "hideContent-=0.5");
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", function() {
                    runLoader(init);
                });
            } else {
                runLoader(init);
            }

            window.addEventListener("pageshow", function (e) {
                if (e.persisted) {
                    gsap.set(getNavAnimEls(), { yPercent: 110 });
                    animateNavIn();
                }
            });

            // -----------------------------------------
            // NAV ANIMATIONS
            // -----------------------------------------

            function getNavAnimEls() {
                return document.querySelectorAll(".nav__clip > *");
            }

            function animateNavIn() {
                if (reducedMotion) return;
                var els = getNavAnimEls();
                if (!els.length) return;
                gsap.to(els, {
                    yPercent: 0,
                    duration: 0.6,
                    stagger: 0.06,
                    ease: "expo.out",
                    overwrite: true,
                });
            }

            // -----------------------------------------
            // SPLIT TEXT REVEAL
            // -----------------------------------------

            var splitInstances = [];

            function initTextReveal(container) {
                if (typeof SplitText === "undefined") return;
                var scope = container || document;

                scope
                    .querySelectorAll('[data-split="title"]')
                    .forEach(function (el) {
                        if (reducedMotion) return;
                        splitInstances.push(
                            new SplitText(el, {
                                type: "words, chars",
                                autoSplit: true,
                                mask: "chars",
                                charsClass: "char",
                                onSplit: function (self) {
                                    gsap.set(self.elements, { autoAlpha: 1 });
                                    return gsap.from(self.chars, {
                                        duration: 1,
                                        yPercent: -120,
                                        scale: 1.2,
                                        stagger: 0.01,
                                        ease: "expo.out",
                                    });
                                },
                            }),
                        );
                    });

                scope
                    .querySelectorAll('[data-split="paragraph"]')
                    .forEach(function (el) {
                        if (reducedMotion) return;
                        splitInstances.push(
                            new SplitText(el, {
                                type: "lines, words",
                                autoSplit: true,
                                mask: "lines",
                                linesClass: "line",
                                onSplit: function (self) {
                                    gsap.set(self.elements, { autoAlpha: 1 });
                                    return gsap.from(self.lines, {
                                        duration: 0.9,
                                        yPercent: 105,
                                        stagger: 0.04,
                                        ease: "expo.out",
                                    });
                                },
                            }),
                        );
                    });
            }

            function initWorkItemReveal(container) {
                if (reducedMotion) return;
                var items = (container || document).querySelectorAll(
                    ".work-item",
                );
                if (!items.length) return;
                gsap.fromTo(
                    items,
                    { yPercent: 100, autoAlpha: 0 },
                    {
                        yPercent: 0,
                        autoAlpha: 1,
                        duration: 0.8,
                        ease: "power3.out",
                        stagger: 0.1,
                    },
                );
            }

            function initMediaReveal(container) {
                if (reducedMotion) return;
                var els = (container || document).querySelectorAll(
                    ".image-block, .video-section, .text-image-block__image",
                );
                if (!els.length) return;
                gsap.fromTo(
                    els,
                    { yPercent: 100, autoAlpha: 0 },
                    {
                        yPercent: 0,
                        autoAlpha: 1,
                        duration: 0.8,
                        ease: "power3.out",
                        stagger: 0.1,
                    },
                );
            }

            function initRecognitionReveal(container) {
                if (reducedMotion) return;
                var rows = (container || document).querySelectorAll(
                    "[data-recognition-row]",
                );
                if (!rows.length) return;
                gsap.from(rows, {
                    duration: 0.6,
                    autoAlpha: 0,
                    y: 10,
                    stagger: 0.04,
                    ease: "expo.out",
                    delay: 0.4,
                });
            }

            // -----------------------------------------
            // WORK VIEW TOGGLE
            // -----------------------------------------

            document.addEventListener("click", function (e) {
                var btn = e.target.closest("[data-view-btn]");
                if (!btn) return;
                applyWorkView(btn.dataset.viewBtn);
            });

            function applyWorkView(view) {
                var section = document.getElementById("work-section");
                if (section) section.dataset.view = view;
                localStorage.setItem("workView", view);
                document
                    .querySelectorAll("[data-view-btn]")
                    .forEach(function (btn) {
                        btn.classList.toggle(
                            "is-active",
                            btn.dataset.viewBtn === view,
                        );
                    });
            }

            function initWorkView() {
                var section = document.getElementById("work-section");
                if (!section) return;
                applyWorkView(localStorage.getItem("workView") || "grid");
            }

            // -----------------------------------------
            // PAGE TRANSITIONS
            // -----------------------------------------

            function animatePageOut(onComplete) {
                if (reducedMotion) {
                    onComplete();
                    return;
                }

                var navEls = getNavAnimEls();
                var lines = document.querySelectorAll(
                    '[data-split="paragraph"] .line',
                );
                var chars = document.querySelectorAll(
                    '[data-split="title"] .char',
                );
                var rows = document.querySelectorAll("[data-recognition-row]");
                var items = document.querySelectorAll(".work-item");
                var media = document.querySelectorAll(
                    ".image-block, .video-section, .text-image-block__image",
                );

                if (
                    !navEls.length &&
                    !chars.length &&
                    !lines.length &&
                    !rows.length &&
                    !items.length &&
                    !media.length
                ) {
                    onComplete();
                    return;
                }

                var tl = gsap.timeline({ onComplete: onComplete });

                if (navEls.length) {
                    tl.to(
                        navEls,
                        {
                            duration: 0.35,
                            yPercent: -110,
                            stagger: 0.06,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (chars.length) {
                    tl.to(
                        chars,
                        {
                            duration: 0.45,
                            yPercent: -120,
                            scale: 1.2,
                            stagger: 0.008,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (lines.length) {
                    tl.to(
                        lines,
                        {
                            duration: 0.45,
                            yPercent: 105,
                            stagger: 0.025,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (rows.length) {
                    tl.to(
                        rows,
                        {
                            duration: 0.3,
                            autoAlpha: 0,
                            y: -8,
                            stagger: 0.02,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (items.length) {
                    tl.to(
                        items,
                        {
                            duration: 0.4,
                            yPercent: -15,
                            autoAlpha: 0,
                            stagger: 0.04,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
                if (media.length) {
                    tl.to(
                        media,
                        {
                            duration: 0.4,
                            yPercent: -15,
                            autoAlpha: 0,
                            stagger: 0.04,
                            ease: "power2.in",
                        },
                        0,
                    );
                }
            }

            document.addEventListener("click", function (e) {
                var link = e.target.closest("a[href]");
                if (!link) return;
                var href = link.getAttribute("href");
                if (
                    !href ||
                    href.startsWith("http") ||
                    href.startsWith("//") ||
                    href.startsWith("mailto") ||
                    href.startsWith("#") ||
                    link.target === "_blank"
                )
                    return;
                e.preventDefault();
                animatePageOut(function () {
                    window.location.href = href;
                });
            });

            // -----------------------------------------
            // HELPERS
            // -----------------------------------------

            function initLenis() {
                if (lenis || !hasLenis) return;
                lenis = new Lenis({ lerp: 0.165, wheelMultiplier: 1.25 });
                gsap.ticker.add(function (time) {
                    lenis.raf(time * 1000);
                });
                gsap.ticker.lagSmoothing(0);
            }
        </script>
    </body>
</html>
